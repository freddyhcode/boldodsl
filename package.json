{
  "name": "boldodsl",
  "version": "0.1.0",
  "description": "A domain-specific language for defining database schemas",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "build:minify": "tsup --minify",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test:run",
    "debug:lexer": "tsx watch ./src/debug/lexer.debug.ts",
    "debug:parser": "tsx watch ./src/debug/parser.debug.ts",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [
    "dsl",
    "database",
    "token",
    "lexer",
    "schema",
    "parser",
    "ast"
  ],
  "author": "freddyhcode",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freddyhcode/boldodsl.git"
  },
  "bugs": {
    "url": "https://github.com/freddyhcode/boldodsl/issues"
  },
  "homepage": "https://github.com/freddyhcode/boldodsl#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
